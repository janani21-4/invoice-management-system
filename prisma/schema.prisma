generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
   url      = env("postgresql://neondb_owner:npg_3qhU9AKCFrWT@ep-wispy-frost-ao52rqs9-pooler.c-2.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require")
}
model User {
  id        String    @id @default(uuid())
  name      String
  email     String    @unique
  password  String
  createdAt DateTime  @default(now())
  invoices  Invoice[]

  @@index([email])
}

enum InvoiceStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model Invoice {
  id            String        @id @default(uuid())
  invoiceNumber String?
  vendorName    String?
  gstNumber     String?
  invoiceDate   DateTime?
  totalAmount   Decimal?      @db.Decimal(12, 2)
  fileUrl       String
  rawText       String?       @db.Text
  status        InvoiceStatus @default(PENDING)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([invoiceDate])
  @@index([vendorName])
  @@index([userId, status])
  @@index([userId, createdAt])
}
